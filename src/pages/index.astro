---
import Layout from '../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';
import { getSkillVisual } from '../utils/skillVisual';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .slice(0, 3);
const projectsToShow = featuredProjects.length > 0
  ? featuredProjects
  : allProjects.slice(0, 3);

const allServices = (await getCollection('services'))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .slice(0, 4);

const settingsEntry = await getEntry('siteSettings', 'settings');
const settings = settingsEntry!.data;

const techStackEntry = await getEntry('techStack', 'techStack');
const techStack = techStackEntry!.data;
---

<Layout title="Saeed Babaee | Computational Engineer">
  <div class="space-y-16">

    <!-- Hero -->
    <section class="space-y-6 pt-4 sm:pt-8">
      <div class="inline-flex items-center rounded-full border border-border px-3 py-1 text-xs font-medium text-muted-foreground bg-muted/50">
        {settings.heroBadge}
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-foreground leading-tight">
        {settings.heroHeadline}
      </h1>

      <p class="text-lg text-muted-foreground max-w-2xl leading-relaxed">
        {settings.heroSubheadline}
      </p>

      <div class="flex flex-wrap gap-3 pt-2">
        <a
          href="/projects"
          class="inline-flex items-center justify-center rounded-md bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground shadow transition-all hover:bg-primary/90 active:scale-[0.98]"
        >
          View Projects
        </a>
        <a
          href="/contact"
          class="inline-flex items-center justify-center rounded-md border border-input bg-background px-5 py-2.5 text-sm font-medium shadow-sm transition-all hover:bg-accent hover:text-accent-foreground active:scale-[0.98]"
        >
          Get in Touch
        </a>
      </div>
    </section>

    <!-- Featured Projects -->
    <section class="space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-2xl font-bold tracking-tight text-foreground">Featured Projects</h2>
          <p class="text-sm text-muted-foreground mt-1">Highlights of recent work and implementations.</p>
        </div>
        <a href="/projects" class="text-sm font-medium text-primary hover:underline hidden sm:inline-flex">
          View All →
        </a>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {projectsToShow.map((project) => (
          <a
            href={`/projects/${project.id}`}
            class="group block overflow-hidden rounded-lg border border-border bg-card shadow-sm transition-all duration-200 hover:shadow-md hover:border-primary/40 hover:-translate-y-0.5"
          >
            {project.data.image ? (
              <div class="aspect-video w-full overflow-hidden bg-muted">
                <img
                  src={project.data.image}
                  alt={project.data.title}
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  loading="lazy"
                />
              </div>
            ) : (
              <div class="aspect-video w-full bg-gradient-to-br from-primary/15 via-muted to-secondary/25 flex items-center justify-center">
                <span class="text-4xl font-bold text-muted-foreground/30 select-none">
                  {(project.data.title || 'P').charAt(0)}
                </span>
              </div>
            )}

            <div class="p-5">
              <div class="text-xs font-medium text-muted-foreground uppercase tracking-wide mb-2">
                {project.data.category || 'Project'}
              </div>
              <h3 class="text-lg font-semibold text-card-foreground group-hover:text-primary transition-colors">
                {project.data.title}
              </h3>
              <p class="text-sm text-muted-foreground mt-2 line-clamp-3 leading-relaxed">
                {project.data.description}
              </p>
              {project.data.tags && project.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-1.5 mt-4 pt-3 border-t border-border/50">
                  {project.data.tags.map((tag) => (
                    <span class="rounded-md bg-muted px-2 py-0.5 text-xs text-muted-foreground transition-colors group-hover:bg-primary/10 group-hover:text-primary">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Services -->
    <section class="space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-2xl font-bold tracking-tight text-foreground">Services</h2>
          <p class="text-sm text-muted-foreground mt-1">Specialized engineering services I offer.</p>
        </div>
        <a href="/services" class="text-sm font-medium text-primary hover:underline hidden sm:inline-flex">
          View All →
        </a>
      </div>

      <div class="grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
        {allServices.map((service) => (
          <a href={`/services/${service.id}`} class="group rounded-lg border border-border bg-card p-4 shadow-sm transition-all duration-200 hover:shadow-md hover:border-primary/40 hover:-translate-y-0.5">
            <h3 class="text-base font-semibold text-card-foreground group-hover:text-primary transition-colors mb-1.5">{service.data.title}</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">{service.data.description}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- Tech Stack -->
    <section id="tech-stack" class="space-y-6 scroll-mt-20">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-foreground">Tech Stack</h2>
        <p class="text-sm text-muted-foreground mt-1">Tools and technologies I work with.</p>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {techStack.categories.map((category) => (
          <div class="rounded-xl border border-border bg-card p-5 shadow-sm transition-all duration-200 hover:shadow-md hover:border-primary/40 hover:-translate-y-0.5">
            <h3 class="text-sm font-semibold text-foreground mb-4">{category.name}</h3>
            <div class="grid grid-cols-3 gap-3">
              {category.skills.map((skill) => {
                const { color, letter } = getSkillVisual(skill.name);
                return (
                  <div class="flex flex-col items-center gap-1.5">
                    {skill.icon ? (
                      <img
                        src={`https://skillicons.dev/icons?i=${skill.icon}`}
                        alt={skill.name}
                        class="h-12 w-12 rounded-lg object-contain"
                        loading="lazy"
                      />
                    ) : (
                      <div class={`flex h-12 w-12 items-center justify-center rounded-lg ${color} text-white text-sm font-bold shadow-sm`}>
                        {letter}
                      </div>
                    )}
                    <span class="text-[11px] font-medium text-foreground text-center leading-tight">{skill.name}</span>
                  </div>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="rounded-lg border border-border bg-card p-8 text-center space-y-4 shadow-sm">
      <h2 class="text-xl font-semibold tracking-tight">{settings.ctaHeading}</h2>
      <p class="text-sm text-muted-foreground max-w-md mx-auto">
        {settings.ctaText}
      </p>
      <a
        href="/contact"
        class="inline-flex items-center justify-center rounded-md bg-primary px-6 py-2.5 text-sm font-medium text-primary-foreground shadow transition-all hover:bg-primary/90"
      >
        Get in Touch
      </a>
    </section>

  </div>
</Layout>
